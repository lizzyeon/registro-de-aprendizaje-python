# 요약: n = 4 -> 수박수박, n = 5 -> 수박수박


# ================================================================
# 내 풀이

def solution(n):
    
    return '수박' * (n//2) if n % 2 == 0 else '수박' * (n//2) + '수'
# ----------------------------------------------------------------
# 조건문을 넣으면 코드가 무거워진다! 다른 방법을 생각해보자


# ================================================================
# 다른 풀이

def solution(n):

    return ('수박' * n)[:n]

# ----------------------------------------------------------------
# 수박을 n개를 만들면 2n개. 그 중에 n개만 사용하는 건 비효율적임
# 필요한 최소한의 양만 만들자


# ================================================================
# 다른 풀이

def solution(n):

    return ('수박' * (n//2 + 1))[:n]
